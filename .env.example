# --- LLM provider selection ---
# One of: openai, anthropic, gemini, deepseek, groq, openrouter, together,
#   ollama, xai, mistral, perplexity, fireworks, huggingface, deepinfra, novita,
#   nvidia, siliconflow, qwen, moonshot, zhipu, replicate, anyscale, scaleway,
#   vllm, lmstudio, textgenwebui, custom
WATERWRITER_LLM_PROVIDER=openai

# Provider API key (not required for local providers: ollama, vllm, lmstudio, textgenwebui)
WATERWRITER_LLM_API_KEY=sk-your-api-key-here

# Per-provider defaults are used if these are left empty. Run
#   waterwriter providers
# to list every provider with its default base URL and model.
#
# Local providers (no key, run your own server):
#   ollama       -> http://localhost:11434/v1                llama3
#   vllm         -> http://localhost:8000/v1                (set WATERWRITER_LLM_MODEL)
#   lmstudio     -> http://localhost:1234/v1                local-model
#   textgenwebui -> http://localhost:5000/v1                textgen

# Optional overrides:
# WATERWRITER_LLM_BASE_URL=https://your-endpoint.example.com/v1
# WATERWRITER_LLM_MODEL=gpt-4o
# WATERWRITER_LLM_API_STYLE=openai      # or "anthropic" / "gemini" for custom endpoints
# WATERWRITER_LLM_EXTRA_HEADERS="X-Custom: value, X-Other: value2"  # arbitrary headers for any endpoint

# --- Persisted provider/model selection ---
# The selected provider/model are also saved in the database (table `settings`)
# and can be changed at any time without editing this file:
#   waterwriter config --provider gemini          # switch provider, then pick a model
#   waterwriter config --select                   # pick a model from the live endpoint
#   waterwriter config --provider openai --model gpt-5.6-sol
# The API key is NEVER stored in the database; it always comes from this env var.
# Environment values here override the database; the database overrides presets.
